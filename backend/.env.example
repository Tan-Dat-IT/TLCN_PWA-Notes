# Sao chép thành backend/.env nếu chưa có .env; không ghi đè cấu hình thật.
DB_SERVER=localhost
DB_NAME=PwaNotesDB
DB_USER=sa
DB_PASSWORD='passSQL'
DB_PORT=1433
# Khi không đặt DB_PORT, dùng DB_INSTANCE và SQL Server Browser:
DB_INSTANCE=SQLEXPRESS
PORT=4000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# SQL local cho demo, chỉ dùng trên máy/mạng tin cậy.
# Với SQL có chứng chỉ hợp lệ: DB_ENCRYPT=true, DB_TRUST_CERTIFICATE=false.
DB_ENCRYPT=false
DB_TRUST_CERTIFICATE=true

# Bí mật ký JWT đăng nhập - BẮT BUỘC đặt giá trị ngẫu nhiên riêng khi NODE_ENV=production.
# Có thể tạo nhanh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-gia-tri-nay-truoc-khi-chay-that
JWT_EXPIRES_IN=7d

# Trợ lý AI chạy local qua Ollama (https://ollama.com) - không gọi cloud.
# Cài Ollama, chạy `ollama serve`, tải model chat và model embedding trước khi dùng:
#   ollama pull llama3.2
#   ollama pull embeddinggemma
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Model embedding cho tìm kiếm ngữ nghĩa và hỏi đáp có dẫn nguồn.
OLLAMA_EMBED_MODEL=embeddinggemma
# Chờ model trả lời tối đa bao lâu (ms). Máy không GPU chạy CPU nên mặc định 60 giây;
# quá hạn thì app vẫn trả bản nháp cơ bản (tiêu đề + ngày giờ) kèm cảnh báo.
OLLAMA_TIMEOUT_MS=60000
# Trợ lý tri thức có thể phải lập chỉ mục ở lần hỏi đầu nên cho phép chờ lâu hơn.
OLLAMA_KNOWLEDGE_TIMEOUT_MS=90000
# AI lập kế hoạch phải ước lượng nhiều công việc trong một structured response.
OLLAMA_PLANNER_TIMEOUT_MS=90000
# Ngưỡng cosine tối thiểu để một ghi chú được dùng làm nguồn (-1 đến 1).
KNOWLEDGE_MIN_SIMILARITY=0.28
# Giữ model trong RAM sau mỗi lần dùng (mặc định của Ollama chỉ 5 phút).
OLLAMA_KEEP_ALIVE=30m

# Gửi email "quên mật khẩu" qua SMTP thật - tùy chọn, không đặt thì tính năng
# này tắt và chỉ còn dùng được script CLI `npm run reset-password` (xem
# README mục 3 Bước 8). Ví dụ dùng Gmail/Google Workspace:
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
#   SMTP_USER=<email gửi>, SMTP_PASS=<App Password 16 ký tự, KHÔNG phải mật khẩu đăng nhập Google>
# Tạo App Password: bật xác minh 2 bước cho tài khoản Google -> myaccount.google.com/apppasswords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Không đặt thì mặc định dùng SMTP_USER làm địa chỉ người gửi.
SMTP_FROM=
# Địa chỉ gốc của app mà link trong email sẽ trỏ tới - phải khớp với cách
# bạn thật sự chạy app (mục 3 Bước 7): Cách A (production, 1 cổng) dùng
# http://localhost:4000, Cách B (dev) dùng http://localhost:5173. Nếu demo
# qua LAN, đổi thành http://<ip-máy-chủ>:<cổng>.
APP_BASE_URL=http://localhost:4173
# Link đặt lại mật khẩu hết hạn sau bao nhiêu phút.
RESET_TOKEN_TTL_MIN=30

# Nhắc việc bằng Web Push - tùy chọn, không đặt thì tính năng này tắt.
# Tạo cặp khóa bằng: npm run vapid-keys (chạy 1 lần, dán 2 dòng in ra vào đây).
# VAPID_SUBJECT là địa chỉ liên hệ gửi kèm cho dịch vụ push (mailto: hoặc https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
